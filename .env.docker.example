APP_NAME="Hotel Management"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8084
APP_PORT=8084

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Use 127.0.0.1 + FORWARD_DB_PORT on the host; docker-compose overrides DB_* for the app container.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3307
DB_DATABASE=hotel_management
DB_USERNAME=hotel_management
DB_PASSWORD=secret
FORWARD_DB_PORT=3307

MYSQL_DATABASE=hotel_management
MYSQL_USER=hotel_management
MYSQL_PASSWORD=secret
MYSQL_ROOT_PASSWORD=root

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=redis

CHROME_PATH=/usr/bin/chromium
BROWSERSHOT_CHROME_PATH=/usr/bin/chromium
WKHTMLTOPDF_BINARY=/usr/bin/wkhtmltopdf
WKHTMLTOIMAGE_BINARY=/usr/bin/wkhtmltoimage
SNAPPY_PDF_BINARY=/usr/bin/wkhtmltopdf
SNAPPY_IMAGE_BINARY=/usr/bin/wkhtmltoimage

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
FORWARD_REDIS_PORT=6379

PHPMYADMIN_PORT=8082
PHPMYADMIN_UPLOAD_LIMIT=128M

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
